  "steps": [
    {
      "name": "Four on the Floor",
      "description": "Lock in steady quarter-note kicks — the heartbeat of house. Count 1-2-3-4 out loud.",
      "playerPads": [
        1
      ],
      "tempoScale": 0.8
    },
    {
      "name": "Backbeat Claps",
      "description": "Claps join on beats 2 and 4 from bar 3. Keep the kick rock solid underneath.",
      "playerPads": [
        1,
        2
      ],
      "tempoScale": 0.85
    },
    {
      "name": "Hats Pass to Shaker",
      "description": "Play the offbeat open hats, hand the groove to the shaker sixteenths in bars 5-6, then catch the hats again in bar 7.",
      "playerPads": [
        4,
        8
      ],
      "tempoScale": 0.85
    },
    {
      "name": "Catch the Stabs",
      "description": "Foundation plus the chord stab on the 'and' of 2. Snap the stab hard while the hats and shaker back you up.",
      "playerPads": [
        1,
        2,
        9
      ],
      "tempoScale": 0.9
    },
    {
      "name": "Perform",
      "description": "Full speed, all pads — pump the floor, ride the shaker section, and land the closing stab into the loop.",
      "playerPads": "all"
    }
  ],
