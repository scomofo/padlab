  },
  "steps": [
    {
      "name": "808 Foundation",
      "description": "Play kick and the tomLow 808 as one low-end voice on the downbeats, then answer with the syncopated 808 hits late in each bar.",
      "playerPads": [
        1,
        4
      ],
      "tempoScale": 0.75
    },
    {
      "name": "Backbeat Stack",
      "description": "Keep the low end going and add the halftime snare on beat 3, stacking the clap on top every other bar.",
      "playerPads": [
        1,
        2,
        3,
        4
      ],
      "tempoScale": 0.8
    },
    {
      "name": "Hat Bursts",
      "description": "Ride eighth-note hats, then snap into the sixteenth-note bursts that close bars 2 and 6; catch the open hat at the end of bar 4.",
      "playerPads": [
        5,
        6
      ],
      "tempoScale": 0.85
    },
    {
      "name": "Trap Details",
      "description": "Layer the offbeat perc, the ghost rimshots on the last sixteenth, and the crashes marking bars 1 and 5 over the full backing.",
      "playerPads": [
        7,
        8,
        13
      ],
      "tempoScale": 0.9
    },
    {
      "name": "Perform",
      "description": "Everything at full speed — 808 lows, halftime crack, bursting hats, and the tom-capped turnaround in bar 8.",
      "playerPads": "all"
    }
  ],
