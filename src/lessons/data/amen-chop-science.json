  "steps": [
    {
      "name": "Amen backbone",
      "description": "Kick pair into the beat-2 snare, displaced snare on the and-of-3, plus the soft ghost cluster. This is the whole break in skeleton form.",
      "playerPads": [
        1,
        2
      ],
      "tempoScale": 0.7
    },
    {
      "name": "Hat-to-ride interplay",
      "description": "Bars 1-4 ride the closed hats, bars 5-8 switch to the ride wash. Keep the cymbal hand steady while the kick displaces under it.",
      "playerPads": [
        1,
        2,
        3,
        4,
        8
      ],
      "tempoScale": 0.8
    },
    {
      "name": "Sub and stabs",
      "description": "Add the bass hits under the drop and the offbeat stab and perc accents. The sub lands with the 2.75 kick - let them glue.",
      "playerPads": [
        1,
        2,
        3,
        4,
        8,
        13,
        14,
        15
      ],
      "tempoScale": 0.85
    },
    {
      "name": "Chop rehearsal",
      "description": "Everything slightly slowed: tom cascade out of bar 4, and the full bar-8 chop with the snare roll into the crash.",
      "playerPads": [
        1,
        2,
        3,
        4,
        8,
        9,
        10,
        11,
        12,
        13,
        14,
        15
      ],
      "tempoScale": 0.9
    },
    {
      "name": "Perform",
      "description": "Full-speed amen science: chopped break, sub pressure, and the roll-to-crash finish.",
      "playerPads": "all"
    }
  ],
